      "parameters": {
        "jsCode": "const questions = JSON.parse($('Examiner Agent').item.json.output);\nconst chatId = $('Extract Quiz Request').item.json.chatId;\nconst q = questions[0];\n\nconst buttons = Object.entries(q.options).map(([key, value]) => ([{\n  text: (key + ') ' + value).substring(0, 30),\n  callback_data: 'answer_0_' + key + '_' + JSON.stringify(questions).length\n}]));\n\nreturn [{\n  json: {\n    chatId: chatId,\n    message: '❓ Question 1/5:\\n\\n' + q.question,\n    buttons: buttons,\n    questions: JSON.stringify(questions),\n    currentIndex: 0\n  }\n}];"
      },
