    {
      "parameters": {
        "jsCode": "const allSessions = $('Get Session').all();\nconst userId = $('Extract Answer').item.json.userId;\nconst chatId = $('Extract Answer').item.json.chatId;\n\n// Get the most recent session for this user that is in_quiz state\nconst activeSessions = allSessions.filter(s => s.json.userId == userId && s.json.state === 'in_quiz');\n\nif (activeSessions.length === 0) {\n  return [{ json: { chatId: chatId, message: '❌ No active quiz found. Use /quiz to start a new one.', isLastQuestion: true, userId: userId } }];\n}\n\n// Sort by updatedAt descending, take the latest\nactiveSessions.sort((a, b) => new Date(b.json.updatedAt) - new Date(a.json.updatedAt));\nconst session = activeSessions[0].json;\n\nconst questions = JSON.parse(session.currentQuiz);\nconst currentIndex = $('Extract Answer').item.json.questionIndex;\nconst selectedAnswer = $('Extract Answer').item.json.selectedAnswer;\n\nconst currentQuestion = questions[currentIndex];\nconst isCorrect = selectedAnswer === currentQuestion.correctAnswer;\n\nlet answers = [];\ntry { answers = JSON.parse(session.answers || '[]'); } catch(e) { answers = []; }\n\nanswers.push({\n  questionIndex: currentIndex,\n  selected: selectedAnswer,\n  correct: currentQuestion.correctAnswer,\n  isCorrect: isCorrect\n});\n\nconst nextIndex = currentIndex + 1;\nconst isLastQuestion = nextIndex >= questions.length;\n\nif (!isLastQuestion) {\n  const nextQ = questions[nextIndex];\n  const buttons = Object.entries(nextQ.options).map(([key, value]) => ([{\n    text: (key + ') ' + value).substring(0, 30),\n    callback_data: 'answer_' + nextIndex + '_' + key\n  }]));\n  \n  let feedback = isCorrect ? '✅ Correct!\\n\\n' : '❌ Wrong! ' + currentQuestion.explanation + '\\n\\n';\n  \n  return [{\n    json: {\n      chatId: chatId,\n      message: feedback + '❓ Question ' + (nextIndex + 1) + '/5:\\n\\n' + nextQ.question,\n      buttons: buttons,\n      answers: JSON.stringify(answers),\n      isLastQuestion: false,\n      userId: userId,\n      currentIndex: nextIndex,\n      rowNumber: session.row_number\n    }\n  }];\n} else {\n  const correctCount = answers.filter(a => a.isCorrect).length;\n  const score = Math.round((correctCount / questions.length) * 100);\n  \n  let resultMessage = '🏆 Quiz Complete!\\n\\nScore: ' + correctCount + '/' + questions.length + ' (' + score + '%)\\n\\n';\n  answers.forEach((a, i) => {\n    resultMessage += (a.isCorrect ? '✅' : '❌') + ' Q' + (i + 1) + ': You answered ' + a.selected + ', correct was ' + a.correct + '\\n';\n  });\n  \n  return [{\n    json: {\n      chatId: chatId,\n      message: resultMessage,\n      isLastQuestion: true,\n      answers: JSON.stringify(answers),\n      userId: userId,\n      currentIndex: nextIndex\n    }\n  }];\n}"
      },
