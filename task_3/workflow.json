      "parameters": {
        "jsCode": "const items = $input.all();\nconst chatId = $('Telegram Trigger').item.json.message.chat.id;\n\nif (!items || items.length === 0) {\n  return [{\n    json: {\n      chatId: chatId,\n      message: \"📚 You have no saved materials yet. Use /learn [URL] to add some!\",\n      hasItems: false\n    }\n  }];\n}\n\nconst validItems = items.filter(item => item.json.title && item.json.title.toString().trim() !== '');\n\nconst buttons = validItems.map((item, index) => ([{\n  text: item.json.title.toString(),\n  callback_data: 'quiz_' + item.json.id.toString()\n}]));\n\nreturn [{\n  json: {\n    chatId: chatId,\n    message: \"📚 Choose a topic for your quiz:\",\n    buttons: buttons,\n    hasItems: true\n  }\n}];"
      },
