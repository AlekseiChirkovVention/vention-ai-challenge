      "parameters": {
        "jsCode": "const raw = $('Teacher Agent').item.json.output;\nconst data = JSON.parse(raw);\n\nconst keyPoints = data.keyPoints.map(p => '• ' + p).join('\\n');\n\nconst message = '✅ Material saved!\\n\\n📚 ' + data.title + '\\n🎯 Difficulty: ' + data.difficulty + '\\n\\n📝 Key Points:\\n' + keyPoints;\n\nreturn [{\n  json: {\n    message: message,\n    chatId: $('Extract URL').item.json.chatId\n  }\n}];"
      },
