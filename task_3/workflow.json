    {
      "parameters": {
        "jsCode": "const data = $input.first().json.callback_query;\nconst parts = data.data.split('_');\nconst questionIndex = parseInt(parts[1]);\nconst selectedAnswer = parts[2];\nconst chatId = data.message.chat.id;\nconst userId = data.from.id.toString();\n\nreturn [{\n  json: {\n    questionIndex: questionIndex,\n    selectedAnswer: selectedAnswer,\n    chatId: chatId,\n    userId: userId\n  }\n}];"
      },
